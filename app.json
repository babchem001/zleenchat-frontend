{
  "expo": {
    "name": "Zleenchat",
    "slug": "zleenchat",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/zalvro_icon_optimized.png",
    "scheme": "ogarenaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to upload profile pictures.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save images"
      }
    },
    "android": {
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "INTERNET",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zleenchat.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/zalvro_icon_optimized.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121314",
          "dark": {
            "image": "./assets/images/zalvro_icon_optimized.png",
            "backgroundColor": "#121314"
          }
        }
      ],

      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Zleenchat uses your camera for video calls.",
          "microphonePermission": "Zleenchat uses your microphone for voice messages and voice or video calls."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Zleenchat uses your microphone to record voice messages, voice and video calls.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-web-browser",
      "expo-video",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-font",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce17fcee-9f30-499b-b041-65607eec10fe"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ce17fcee-9f30-499b-b041-65607eec10fe"
    }
  }
}
